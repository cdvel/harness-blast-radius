{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash(npm run *)", "WebFetch(domain:docs.rs)"],
    "ask": ["Bash(git push *)"],
    "deny": ["Read(./secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "echo harness-blast-radius example hook" }]
      }
    ]
  }
}
