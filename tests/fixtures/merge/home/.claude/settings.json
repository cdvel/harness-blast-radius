{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Read", "Bash(git status)"],
    "deny": ["Read(~/.ssh/**)"]
  },
  "env": { "SHARED": "user", "USER_ONLY": "1" },
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "~/.claude/hooks/guard.sh" }] }
    ]
  }
}
